{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "type": "dezog",
            "request": "launch",
            "name": "Z80 zsim",
            "remoteType": "zsim",
            "zsim": {
                "memoryModel": "RAM",
                "cpuFrequency": 100000,   // 100 kHz instead of 4 MHz
                "limitSpeed": true
            },
            "rootFolder": "${workspaceFolder}",
            "z88dkv2": [
                { "path": "src/firmware/*.lis", "srcDirs": [""], "mapFile": "build/firmware.map" }
            ],
            "topOfStack": "__register_sp",
            "loadObjs": [
                { "path": "build/firmware_CODE.bin", "start": "0x0000" },
                { "path": "build/firmware_DATA.bin", "start": "0x8000" },
                { "path": "build/weights_payload.bin", "start": "0x1000" },
                { "path": "build/case.bin", "start": "0x7800" }
            ],
            "execAddress": "0x0000",
            "startAutomatically": false,
        }
    ]
}